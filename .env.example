# 프론트엔드 환경변수
# 백엔드를 Supabase → Spring(MySQL) 으로 포팅했습니다.
#
# Spring 백엔드 API 주소 (기본값: http://localhost:8080/api)
#   - 로컬 개발: 보통 기본값 그대로라 .env 없이도 동작
#   - 운영: 배포된 백엔드 주소로 지정 (예: https://api.회사도메인.com/api)
VITE_API_BASE=http://localhost:8080/api

# (레거시) Supabase 변수 — 현재 코드에서는 미사용. Supabase 버전으로 되돌릴 때만 필요.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
