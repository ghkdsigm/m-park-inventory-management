# Supabase 연결 정보
#  - 로컬(Docker): `supabase start` 실행 후 출력되는 API URL / anon key 사용
#      VITE_SUPABASE_URL=http://localhost:54321
#      VITE_SUPABASE_ANON_KEY=<supabase start 가 출력한 anon key>
#  - 클라우드: Supabase 프로젝트 > Settings > API 의 Project URL / anon public key
#
# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (PowerShell: Copy-Item .env.example .env)

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=여기에_anon_key
