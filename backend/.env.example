# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 커밋되지 않습니다(.gitignore).

# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급, sk- 로 시작)
OPENAI_API_KEY=

# (선택) 사용할 모델. 기본값 gpt-4o. 이미지 인식은 gpt-4o / gpt-4o-mini 사용.
# AI_MODEL=gpt-4o

# MiniMax(Hailuo) TTS — 챗봇 AI 답변 음성 출력용. 미설정 시 브라우저 기본 음성으로 폴백.
# MiniMax 플랫폼(https://www.minimaxi.com)에서 API Key 와 GroupId 발급.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# (선택) 음성 모델/보이스. 기본값: speech-02-hd / Korean_SweetGirl
# MINIMAX_MODEL=speech-02-hd
# MINIMAX_VOICE_ID=Korean_SweetGirl
# (선택) base-url. 국제(minimax.io) 계정 기본값 = https://api.minimax.io / 중국 본토 계정 = https://api.minimax.chat
# MINIMAX_BASE_URL=https://api.minimax.io
