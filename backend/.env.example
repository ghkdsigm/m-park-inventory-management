# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우세요.
#   cp .env.example .env
# 서버 이관(EC2/Railway/Docker) 시 아래 항목만 바꾸면 되도록 정리한 예시입니다.

# =========================
# 서버 / 데이터베이스
# =========================
# 배포 플랫폼이 PORT 를 주입하지 않으면 기본 8080 사용
# PORT=8080

# 통째로 바꾸기 쉬운 DB URL (EC2 로컬 MySQL / RDS 모두 대응)
# 예) DB_URL=jdbc:mysql://127.0.0.1:3306/mpark_wms?serverTimezone=Asia/Seoul&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://localhost:3306/mpark_wms?serverTimezone=Asia/Seoul&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=mpark
DB_PASSWORD=mpark

# =========================
# 보안 / CORS
# =========================
JWT_SECRET=change-this-to-a-long-random-secret
# JWT_EXPIRATION_MS=604800000
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://your-frontend-domain.com

# =========================
# 파일 업로드
# =========================
# STORAGE_DIR=./uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# =========================
# OpenAI
# =========================
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급, sk- 로 시작)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_EXTRACT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# MiniMax(Hailuo) TTS
# =========================
# 챗봇 AI 답변 음성 출력용. 미설정 시 브라우저 기본 음성으로 폴백.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# MINIMAX_MODEL=speech-02-hd
# MINIMAX_VOICE_ID=Korean_SweetGirl
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_SPEED=1.2

# =========================
# 선택 옵션
# =========================
# JPA_DDL_AUTO=validate
# HIBERNATE_FORMAT_SQL=true
# HIBERNATE_SQL_LOG_LEVEL=debug
# FLYWAY_ENABLED=true
# FLYWAY_LOCATIONS=classpath:db/migration
# FLYWAY_BASELINE_ON_MIGRATE=true
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=12MB
